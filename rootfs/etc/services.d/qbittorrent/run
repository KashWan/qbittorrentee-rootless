#!/bin/sh
# =============================================================================
#  s6-overlay longrun · qBittorrent Enhanced Edition
#
#  约定：
#    * 本脚本必须 exec 前台进程，否则 s6-supervise 无法正确托管
#    * 身份/umask 全部来自 00-identity 写下的 state.env，避免重复判断
# =============================================================================

set -eu

# s6-overlay v3 的 PID 1 用的是干净环境：WEBUI_PORT / QBT_EXTRA_ARGS / TZ
# 只存在于 /run/s6/container_environment，必须显式导回来。
# 不导的话 TZ 会退回 UTC（时间显示差 8 小时），WEBUI_PORT 也不生效。
# shellcheck source=../../../usr/local/bin/qbt-lib.sh
. "${QBT_LIB:-/usr/local/bin/qbt-lib.sh}"
qbt_load_container_env

STATE_FILE="${QBT_STATE_DIR:-/run/qbittorrentee}/state.env"
if [ ! -r "${STATE_FILE}" ]; then
	echo "[qbittorrent] 缺少 ${STATE_FILE}，stage2 初始化未完成" >&2
	exit 1
fi
# shellcheck disable=SC1090
. "${STATE_FILE}"

umask "${QBT_UMASK}"
HOME="${QBT_CONFIG_DIR}"
export HOME

# 一行摘要：排障时第一眼看的就是它（与 00-identity 打印的身份块互相印证）
echo "[qbittorrent] 启动 profile=${QBT_CONFIG_DIR} 场景=${QBT_SCENARIO:-unknown} 身份=${QBT_RUN_USER}(${QBT_RUN_UID}:${QBT_RUN_GID})" >&2

mkdir -p "${QBT_STATE_DIR:-/run/qbittorrentee}"
date +%s > "${QBT_STATE_DIR:-/run/qbittorrentee}/started_at" 2>/dev/null || true

set -- --profile="${QBT_CONFIG_DIR}"

# 只有在用户显式设置 WEBUI_PORT 时才用命令行覆盖，
# 否则尊重 qBittorrent.conf 里已有的端口（方便从旧镜像迁移）。
if [ -n "${WEBUI_PORT:-}" ]; then
	set -- "$@" --webui-port="${WEBUI_PORT}"
fi

# 追加自定义参数：QBT_EXTRA_ARGS="--disable-tracker-ssl" 之类
if [ -n "${QBT_EXTRA_ARGS:-}" ]; then
	# shellcheck disable=SC2086
	set -- "$@" ${QBT_EXTRA_ARGS}
fi

if [ "${QBT_SWITCH}" = "1" ]; then
	exec /command/s6-setuidgid "${QBT_RUN_USER}" /usr/local/bin/qbittorrent-nox "$@"
fi

exec /usr/local/bin/qbittorrent-nox "$@"
