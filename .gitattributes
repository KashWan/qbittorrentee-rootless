# 统一换行符为 LF：Windows 上编辑后拷贝到 Linux 也不会出现 CRLF
# （CRLF 会让 shell 脚本在容器里报 "$'\r': command not found"）
* text=auto eol=lf

*.sh    text eol=lf
*.conf  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
Dockerfile  text eol=lf
Makefile    text eol=lf

# 二进制/归档类不要参与换行转换
*.gz  binary
*.xz  binary
*.zip binary
*.tar binary
