# =============================================================================
#  .env.example · 复制成 .env 后按需修改（.env 已在 .gitignore 里）
#
#  docker compose 会自动读取同目录下的 .env；Quadlet 用户请直接改
#  quadlet/qbittorrentee.container 或让 install-quadlet.sh 渲染。
#
#  这里全是示例值，没有任何真实凭据。本镜像不含硬编码密码。
# =============================================================================

# --- 镜像 -------------------------------------------------------------------
# 可选任意 tag：latest / 5.2.4.10（钉死版本）/ 5.2 / edge
IMAGE_TAG=latest

# --- 运行身份 ---------------------------------------------------------------
# rootful Docker  ：填你的 uid/gid（id -u / id -g 的输出）
# rootless Podman ：填 0 / 0 —— 容器 root 就是宿主上的你，属主天然正确
PUID=1000
PGID=1000

# 文件权限掩码。个人独占用 022；多人共享下载目录常用 002（组可写）
UMASK=022

# --- 端口 -------------------------------------------------------------------
# WebUI 端口。改了这里，容器内监听端口与映射端口会一起变
WEBUI_PORT=8080
# BT 监听端口（TCP + UDP）
BT_PORT=6881

# --- 时区与语言 -------------------------------------------------------------
TZ=Asia/Shanghai
# WebUI 语言：zh / en / ...
QBITTORRENT_LOCALE=zh

# --- 数据目录 ---------------------------------------------------------------
# 相对路径基于本文件所在目录
CONFIG_DIR=./config
DOWNLOADS_DIR=./downloads

# --- 权限与初始化 -----------------------------------------------------------
# none（默认，推荐）| dir | recursive
#   下载目录里已有大量数据时保持 none：容器不会去遍历/改属主
#   rootless（PUID=0）下这三档都不会执行 chown
CHOWN_DOWNLOADS=none

# 首次启动是否写入默认 qBittorrent.conf（已存在配置时忽略此值）
SEED_CONFIG=true

# 需要访问额外磁盘时填组 gid，逗号分隔；账号会被加进这些组
# EXTRA_GROUPS=44,109

# 追加给 qbittorrent-nox 的原始参数
# QBT_EXTRA_ARGS=--disable-tracker-ssl
